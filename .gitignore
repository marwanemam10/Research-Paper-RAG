# Virtual Environments
# ==========================================
RAG-chain/
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env.local
.env.*.local
*.env
# Ensure example file is tracked
!.env.example

